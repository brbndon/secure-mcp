---
import BrandMark from "./BrandMark.astro";

const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Overview" },
  { href: "/help/", label: "Getting Started" },
  { href: "/support/", label: "Support" },
  { href: "/privacy/", label: "Privacy" },
] as const;

function isCurrent(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href);
}
---

<header
  class="sticky top-0 z-30 border-b border-transparent bg-canvas/80 backdrop-blur-xl supports-[backdrop-filter]:bg-canvas/70"
>
  <div class="site-shell relative flex min-h-16 items-center justify-between gap-6 md:min-h-[4.75rem]">
    <a
      href="/"
      class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] font-medium tracking-[-0.01em] text-ink no-underline"
      aria-label="secure-mcp home"
    >
      <BrandMark />
      <span>secure-mcp</span>
    </a>

    <button
      class="menu-toggle inline-flex min-h-10 items-center rounded-full border border-line bg-surface px-3.5 text-sm font-medium text-ink md:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      Menu
    </button>

    <nav
      id="site-nav"
      class="site-nav absolute top-14 right-0 z-20 hidden min-w-48 grid-cols-1 gap-0.5 rounded-2xl border border-line bg-surface p-1.5 shadow-soft md:static md:flex md:min-w-0 md:items-center md:gap-0.5 md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      aria-label="Primary navigation"
      data-site-nav
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "inline-flex min-h-11 items-center rounded-full px-3.5 text-[0.875rem] no-underline transition-colors md:min-h-9",
              isCurrent(link.href)
                ? "bg-[#e8e8ed] font-medium text-ink md:bg-[#e8e8ed]"
                : "text-muted hover:bg-[#efeff1] hover:text-ink",
            ]}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-site-nav]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("hidden", open);
    nav?.classList.toggle("grid", !open);
  });

  // Close mobile menu after navigation or outside click
  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (window.matchMedia("(max-width: 767px)").matches) {
        toggle?.setAttribute("aria-expanded", "false");
        nav.classList.add("hidden");
        nav.classList.remove("grid");
      }
    });
  });
</script>
