---
import BrandMark from "./BrandMark.astro";

const year = new Date().getFullYear();

const links = [
  { href: "/help/", label: "Getting Started" },
  { href: "/support/", label: "Contact Support" },
  { href: "/privacy/", label: "Privacy Policy" },
  { href: "/terms/", label: "Terms of Service" },
] as const;
---

<footer
  class="site-shell mt-auto grid gap-10 border-t border-line py-14 md:grid-cols-[1.35fr_1fr_auto] md:gap-10 md:py-16"
>
  <div>
    <a
      href="/"
      class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] font-medium tracking-[-0.01em] text-ink no-underline"
    >
      <BrandMark />
      <span>secure-mcp</span>
    </a>
    <p class="mt-3.5 max-w-xs text-sm leading-relaxed text-muted">
      Defensive, remediation-focused security review for coding agents.
    </p>
    <p class="mt-5 max-w-sm text-xs leading-relaxed text-faint">
      Read-only tools · Runs locally over stdio · No network or telemetry
    </p>
  </div>

  <nav
    class="grid grid-cols-2 content-start gap-x-8 gap-y-2"
    aria-label="Footer navigation"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="inline-flex min-h-8 items-center text-sm text-muted no-underline transition-colors hover:text-ink"
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <p class="self-end m-0 text-sm text-faint whitespace-nowrap">
    © {year} secure-mcp
  </p>
</footer>
