---
/**
 * Terminal window chrome — the product's "device frame".
 * Body content goes in the slot; used for both the illustrative hero
 * mockup and the real captured-output panels in the screenshots section.
 */
interface Props {
  /** Window title shown in the title bar */
  title: string;
  /** Accessible label describing the panel content */
  label: string;
  /** Optional max height for scrollable body content */
  maxHeightClass?: string;
  class?: string;
}

const {
  title,
  label,
  maxHeightClass = "",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-[1.15rem] bg-night shadow-soft ring-1 ring-black/15",
    className,
  ]}
  role="img"
  aria-label={label}
>
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
    <span class="flex gap-1.5" aria-hidden="true">
      <i class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></i>
      <i class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></i>
      <i class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></i>
    </span>
    <span class="ml-1.5 truncate font-mono text-[0.7rem] text-[#a1a1a6]">
      {title}
    </span>
  </div>
  <div
    class:list={[
      "overflow-auto p-4 font-mono text-[0.72rem] leading-[1.65] text-[#f5f5f7]/90 md:p-5 md:text-[0.75rem]",
      maxHeightClass,
    ]}
  >
    <slot />
  </div>
</div>
