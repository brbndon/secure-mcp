# Required: license key for secure-mcp. Production format: smcp_<payload>.<base64url-signature>
# Development / smoke-test key (documented for local + CI only):
#   Set SECURE_MCP_DEV_MODE=1 AND the dev key below to allow startup (emits warning on stderr; not for prod).
SECURE_MCP_DEV_MODE=1
SECURE_MCP_LICENSE_KEY=smcp_dev_local_testing_key_v1

# Optional: absolute path to a local license file containing a single key
# SECURE_MCP_LICENSE_FILE=/path/to/license.key

# Required for signed production licenses (PEM public key; never a private key)
# SECURE_MCP_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."

# Required outside dev mode. Use the OS path delimiter for multiple roots.
# SECURE_MCP_ALLOWED_ROOTS=/absolute/path/to/authorized/repository

# Optional hardening caps (the server applies fixed upper bounds as well)
# SECURE_MCP_MAX_TOTAL_BYTES=67108864
