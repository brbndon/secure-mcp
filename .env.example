# Required for filesystem tools. Use the OS path delimiter for multiple roots
# (`:` on macOS/Linux, `;` on Windows).
SECURE_MCP_ALLOWED_ROOTS=/absolute/path/to/authorized/repository

# Optional: set to 1 to allow secure_mcp_run_local_scanners when the tool is
# also called with enable: true. Default off (fail-closed).
# SECURE_MCP_LOCAL_SCANNERS=1

# Optional hardening caps (the server applies fixed upper bounds as well)
# SECURE_MCP_MAX_TOTAL_BYTES=67108864
