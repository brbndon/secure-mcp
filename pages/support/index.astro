---
import LandingLayout from "../_home/LandingLayout.astro";
import PageIntro from "../_home/components/PageIntro.astro";

const pageTitle = "Support — secure-mcp";
const pageDescription =
  "Get support for secure-mcp through public GitHub Issues.";
---

<LandingLayout title={pageTitle} description={pageDescription} route="/support">
  <PageIntro
    eyebrow="Support"
    title="Start with GitHub Issues."
    titleId="support-title"
    lede="Use Issues for bugs, setup questions, and feature ideas. Do not post credentials, private source, or sensitive audit output."
    wide
  />
  <section class="site-shell grid gap-5 pb-24 md:grid-cols-1 md:pb-32" aria-label="Support options">
    <article class="rounded-[1.25rem] border border-line bg-surface p-7 shadow-soft">
      <p class="eyebrow">Public support</p>
      <h2 class="m-0 mb-3 text-[1.35rem] font-semibold tracking-[-0.02em]">Bugs, setup, and ideas</h2>
      <p class="mb-6 text-[0.9375rem] leading-relaxed text-muted">
        Search existing reports, then open an issue with the version, client,
        environment, and smallest safe reproduction.
      </p>
      <a class="btn" href="https://github.com/brbndon/secure-mcp/issues">Browse GitHub Issues</a>
    </article>
  </section>
</LandingLayout>
