---
// Landing page — a Blume custom page mounted at "/" (wins over generated
// routes). Uses LandingLayout, which wraps Blume's PageLayout so the page
// shares the site header (search; dark-only chrome), fonts, favicon, and
// generated OG card with the docs pages.
import LandingLayout from "./_home/LandingLayout.astro";
import TerminalMockup from "./_home/components/TerminalMockup.astro";
import TerminalFrame from "./_home/components/TerminalFrame.astro";
import TrustStrip from "./_home/components/TrustStrip.astro";
import FindingAnatomy from "./_home/components/FindingAnatomy.astro";

// Real output captured from the current build (v1, fixtures/tiny-app).
// Regenerate with `node scripts/capture-output.mjs` (formerly web/scripts).
import inventory from "./_home/captures/01-inventory.json?raw";
import knowledgePack from "./_home/captures/03-knowledge-pack.json?raw";
import secretsFindings from "./_home/captures/04-secrets.json?raw";
import remediationReport from "./_home/captures/05-report.md?raw";

// Deployment base ("/" on Vercel, "/secure-mcp/" on GitHub Pages).
const base = import.meta.env.BASE_URL;

const pageTitle = "secure-mcp — Defensive security review for coding agents";
const pageDescription =
  "secure-mcp is a local MCP server that helps coding agents inventory repositories, classify weaknesses, and produce remediation-focused findings — read-only, over stdio, on your machine.";

const screens = [
  {
    src: inventory,
    sessionTitle: "acme-web",
    header: "secure_mcp_list_project_structure",
    headerKind: "tool" as const,
    label:
      "pi session expanded tool result: real inventory output from a bounded scan of the fixture repository — stacks, file counts, sample paths, and coverage",
    title: "Inventory",
    caption: "A bounded scan: stacks, paths, caps — and exactly what was covered.",
  },
  {
    src: knowledgePack,
    sessionTitle: "acme-web",
    header: "secure_mcp_get_knowledge_pack",
    headerKind: "tool" as const,
    label:
      "pi session expanded tool result: real knowledge-pack output — five stack-aware packs loaded as eight checklist items with remediation",
    title: "Guidance",
    caption: "Stack-aware checklists on demand — five packs, eight items, fixes included.",
  },
  {
    src: secretsFindings,
    sessionTitle: "acme-web",
    header: "secure_mcp_review_secrets",
    headerKind: "tool" as const,
    label:
      "pi session expanded tool result: real secrets review — structured findings with severity, confidence, redacted evidence, and remediation",
    title: "Findings",
    caption: "A structured finding — severity, confidence, redacted evidence, remediation.",
  },
  {
    src: remediationReport,
    sessionTitle: "acme-web",
    header: "secure_mcp_produce_findings",
    headerKind: "tool" as const,
    label:
      "pi session expanded tool result: real remediation report — severity summary plus each finding's classification, evidence, and verification",
    title: "Report",
    caption: "The final remediation report — priorities first, verification with every fix.",
  },
] as const;

const benefits = [
  {
    kicker: "Bounded",
    title: "Reviews that stay in scope",
    body: "File, depth, and size caps with structured coverage — scans are finite, and what was not covered is said out loud.",
  },
  {
    kicker: "Stack-aware",
    title: "Guidance for your actual stack",
    body: "Knowledge packs for TypeScript, Next.js, Swift, and Expo load only what the detected stack needs — never a generic checklist dump.",
  },
  {
    kicker: "Structured",
    title: "Findings built to act on",
    body: "Every finding carries evidence, severity and confidence, category and CWE, remediation, residual risk, and a verification step.",
  },
  {
    kicker: "Honest",
    title: "Coverage you can trust",
    body: "“Not observed” never means “not scanned”: coverage records reviewed, ignored, excluded, and truncated scope, and candidates stay unconfirmed until proven.",
  },
  {
    kicker: "Portable",
    title: "Works in every agent",
    body: "A plain stdio MCP server — the same tools connect to Claude, Codex, Cursor, pi, and any MCP client.",
  },
  {
    kicker: "Remediation-first",
    title: "Defensive, by mandate",
    body: "Findings recommend rotation, hardening, and verification. No exploit guidance, no attack code, no misuse of discovered secrets.",
  },
] as const;

const communityPaths = [
  {
    title: "Inspect every boundary",
    body: "Read the filesystem containment, redaction, tool schemas, knowledge packs, and tests in the public repository.",
    label: "Browse the source",
    href: "https://github.com/brbndon/secure-mcp",
  },
  {
    title: "Shape the roadmap",
    body: "Report false positives, propose stack coverage, and bring real defensive-review workflows to the issue tracker.",
    label: "Open an issue",
    href: "https://github.com/brbndon/secure-mcp/issues",
  },
  {
    title: "Contribute safely",
    body: "Add tests, detectors, and remediation guidance while preserving the read-only and evidence-first trust model.",
    label: "Read the contributor guide",
    href: "https://github.com/brbndon/secure-mcp/blob/main/CONTRIBUTING.md",
  },
] as const;

const clarityPoints = [
  "Severity and confidence on every finding",
  "CWE classification with stable instance IDs",
  "Evidence redacted where sensitive",
  "Remediation with a verification step",
] as const;

const openSourcePoints = [
  "Nine tools in one server: inventory, architecture, packs, guidance, and category reviews",
  "Stack-aware knowledge packs for TypeScript, Next.js, Swift, and Expo",
  "Structured findings with remediation and verification steps",
  "Runs locally — read-only, no network, no telemetry",
] as const;

const faqs = [
  {
    q: "What is secure-mcp?",
    a: "A local MCP server that gives coding agents a structured, defensive toolkit for code review: bounded inventory, stack-aware guidance, category checks, and a final remediation report — all over stdio, on your machine.",
  },
  {
    q: "Does it run my code?",
    a: "No. Every tool is read-only: files under the project root are read within size and count caps, and project code, build scripts, and binaries are never executed.",
  },
  {
    q: "Does my code leave my machine?",
    a: "No. secure-mcp is a local process with no network calls. Logs go to stderr only, stdout stays reserved for MCP messages, and filesystem tools are limited to explicitly allowed roots.",
  },
  {
    q: "Which stacks does it support?",
    a: "In v1: TypeScript and Next.js (App Router, Server Actions, middleware) and Swift and SwiftUI, with Expo and React Native detection. More surfaces are planned.",
  },
  {
    q: "Is this an offensive tool?",
    a: "No. It is remediation-focused by mandate: findings recommend rotation, hardening, and verification — never exploit guidance or attack code.",
  },
] as const;
---

<LandingLayout title={pageTitle} description={pageDescription} route="/">
  <!-- Hero -->
    <section
      class="site-shell grid items-center gap-12 pt-10 pb-6 sm:pt-14 sm:pb-8 md:grid-cols-[minmax(0,1fr)_minmax(20rem,1.15fr)] md:gap-10 md:pt-8 md:pb-4 lg:grid-cols-[minmax(0,0.95fr)_minmax(24rem,1.2fr)] lg:gap-14 lg:pt-12 lg:pb-6"
      aria-labelledby="hero-title"
    >
      <div class="relative z-10 max-w-xl md:py-10 lg:py-14">
        <p class="eyebrow">Defensive security review for coding agents</p>
        <h1 id="hero-title" class="display-title mb-6">
          Find the weaknesses.<br />Fix the right ones.
        </h1>
        <p class="lede text-[1.125rem] md:text-[1.1875rem]">
          secure-mcp inventories your repository, detects its stack, and turns
          likely weaknesses into structured, remediation-focused findings —
          without ever executing your code.
        </p>

        <div class="mt-9 flex w-full max-w-md flex-col items-stretch gap-3 sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center">
          <a
            class="btn w-full sm:w-auto"
            href="https://github.com/brbndon/secure-mcp"
          >
            View on GitHub
          </a>
          <a
            class="btn btn-secondary w-full sm:w-auto"
            href="#screens"
          >
            See it in action
          </a>
          <a
            class="inline-flex min-h-11 items-center justify-center px-1 text-[0.9375rem] font-medium text-ink underline decoration-line underline-offset-[0.35rem] transition-colors hover:decoration-ink sm:justify-start"
            href={`${base}help/`}
          >
            Read the quickstart
          </a>
        </div>
        <p class="microcopy">
          Open source under Apache-2.0. Local by design, with no telemetry.
        </p>
      </div>

      <div class="relative flex justify-center md:justify-end md:pr-2 lg:pr-4">
        <TerminalMockup />
      </div>
    </section>

    <div class="site-shell">
      <div class="border-t border-line"></div>
    </div>
    <TrustStrip />

    <!-- Screens -->
    <section
      class="site-shell py-24 md:py-32"
      aria-labelledby="screens-title"
      id="screens"
    >
      <div class="max-w-2xl">
        <p class="eyebrow">See it in action</p>
        <h2 id="screens-title" class="section-title mb-5">
          One server, four honest outputs.
        </h2>
        <p class="lede">
          Real tool output from a live audit of the bundled fixture app, shown
          the way it appears when pi expands a secure-mcp tool call — inventory,
          guidance, findings, and the final report.
        </p>
      </div>

      <ul
        class="mt-14 -mx-4 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:p-0 sm:snap-none lg:gap-6"
        aria-label="Real secure-mcp output in a pi session"
      >
        {
          screens.map((screen) => (
            <li
              class="w-[88vw] max-w-[28rem] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink"
            >
              <figure class="m-0">
                <TerminalFrame
                  title={screen.sessionTitle}
                  header={screen.header}
                  headerKind={screen.headerKind}
                  label={screen.label}
                  maxHeightClass="max-h-[16rem] sm:max-h-[17rem] lg:max-h-[18rem]"
                >
                  <pre class="m-0 whitespace-pre" style="color: #b8b8c0;"><code>{screen.src}</code></pre>
                </TerminalFrame>
                <figcaption class="mt-4 px-0.5">
                  <strong class="block text-[0.9375rem] font-semibold tracking-[-0.01em] text-ink">
                    {screen.title}
                  </strong>
                  <span class="mt-1 block text-[0.8125rem] leading-snug text-muted">
                    {screen.caption}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Benefits -->
    <section
      class="relative left-1/2 right-1/2 w-screen -ml-[50vw] -mr-[50vw] bg-[#efeff1]"
      aria-labelledby="benefits-title"
    >
      <div class="site-shell py-24 md:py-32">
        <div class="max-w-2xl">
          <p class="eyebrow">What you get</p>
          <h2 id="benefits-title" class="section-title mb-5">
            Everything a serious review needs, in one local server.
          </h2>
          <p class="lede">
            Built for the practical moments — scoping the work, guiding the
            agent, and handing a fix plan to a human.
          </p>
        </div>

        <ul class="mt-14 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {
            benefits.map((benefit) => (
              <li
                class="rounded-[1.25rem] border border-line bg-surface p-6 shadow-soft"
              >
                <span class="block text-[0.6875rem] font-semibold tracking-[0.08em] text-muted uppercase">
                  {benefit.kicker}
                </span>
                <h3 class="mt-2.5 mb-2 text-[1.125rem] font-semibold tracking-[-0.015em] text-ink">
                  {benefit.title}
                </h3>
                <p class="m-0 text-[0.9375rem] leading-relaxed text-muted">
                  {benefit.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Finding clarity -->
    <section
      class="site-shell grid items-center gap-14 py-24 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:gap-16 md:py-32 lg:gap-24"
      aria-labelledby="clarity-title"
    >
      <div class="order-2 md:order-1">
        <FindingAnatomy />
      </div>

      <div class="order-1 md:order-2">
        <p class="eyebrow">Finding clarity</p>
        <h2 id="clarity-title" class="section-title mb-5 max-w-lg">
          Structured underneath. Actionable on top.
        </h2>
        <p class="lede">
          Every finding carries the fields a developer needs to act — and the
          honesty to say what is not yet proven.
        </p>
        <ul class="mt-8 grid list-none gap-3.5 p-0">
          {
            clarityPoints.map((item) => (
              <li class="flex items-center gap-3 text-[1rem] text-muted">
                <span
                  class="mt-px h-1.5 w-1.5 shrink-0 rounded-full bg-ink"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Open-source community -->
    <section
      class="relative left-1/2 right-1/2 w-screen -ml-[50vw] -mr-[50vw] bg-[#efeff1]"
      aria-labelledby="community-title"
    >
      <div class="site-shell py-24 md:py-32">
        <div class="max-w-2xl">
          <p class="eyebrow">Built in public</p>
          <h2 id="community-title" class="section-title mb-5">
            Security tooling should be inspectable.
          </h2>
          <p class="lede">
            The implementation, tests, review methodology, and contribution
            process are open for scrutiny and improvement.
          </p>
        </div>

        <ul class="mt-14 grid list-none gap-4 p-0 md:grid-cols-3">
          {
            communityPaths.map((item) => (
              <li
                class="flex flex-col justify-between gap-7 rounded-[1.25rem] border border-line bg-surface p-6 shadow-soft md:p-7"
              >
                <div>
                  <h3 class="m-0 text-[1.125rem] font-semibold tracking-[-0.015em] text-ink">
                    {item.title}
                  </h3>
                  <p class="mt-3 mb-0 text-[0.9375rem] leading-relaxed text-muted">
                    {item.body}
                  </p>
                </div>
                <a
                  class="text-[0.9375rem] font-medium text-ink underline decoration-line underline-offset-[0.25em] transition-colors hover:decoration-ink"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Open source -->
    <section
      class="site-shell py-24 md:py-32"
      aria-labelledby="open-source-title"
      id="open-source"
    >
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Apache-2.0</p>
        <h2 id="open-source-title" class="section-title mb-5">
          Free to use. Open to improve.
        </h2>
        <p class="lede mx-auto">
          Use, modify, and distribute secure-mcp under a permissive license
          with an explicit patent grant.
        </p>
      </div>

      <div
        class="mx-auto mt-14 max-w-md rounded-[1.5rem] border border-line bg-surface p-8 shadow-soft md:p-10"
      >
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="m-0 text-lg font-semibold tracking-[-0.01em] text-ink">
            secure-mcp
          </h3>
          <span class="text-[2rem] font-semibold tracking-[-0.03em] text-ink">
            $0
          </span>
        </div>
        <p class="mt-2 mb-0 text-[0.9375rem] text-muted">
          All nine tools, stack-aware packs, and remediation reports.
        </p>
        <ul class="mt-6 grid list-none gap-3 border-t border-line p-0 pt-6 text-[0.9375rem] text-ink">
          {
            openSourcePoints.map((point) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-ink"
                  aria-hidden="true"
                />
                {point}
              </li>
            ))
          }
        </ul>
        <a class="btn mt-8 w-full" href="https://github.com/brbndon/secure-mcp">
          Get the source
        </a>
        <p class="microcopy text-center">
          Apache-2.0 terms apply. Contributions are welcome.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="site-shell pb-24 md:pb-32" aria-labelledby="faq-title" id="faq">
      <div class="max-w-2xl">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" class="section-title mb-5">
          Common questions, straight answers.
        </h2>
        <p class="lede">
          Short answers about what the server does — and what it deliberately
          does not do.
        </p>
      </div>

      <div class="mt-12 max-w-3xl border-t border-line">
        {
          faqs.map((faq) => (
            <details class="faq-item group border-b border-line">
              <summary class="flex min-h-[4.25rem] cursor-pointer items-center justify-between gap-6 py-4 text-left text-[1.0625rem] font-medium tracking-[-0.01em] text-ink">
                <span>{faq.q}</span>
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#e8e8ed] text-base font-normal text-ink transition group-open:hidden"
                  aria-hidden="true"
                >
                  +
                </span>
                <span
                  class="hidden h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#e8e8ed] text-base font-normal text-ink group-open:flex"
                  aria-hidden="true"
                >
                  −
                </span>
              </summary>
              <div class="max-w-2xl pb-6 pr-12 text-[1.025rem] leading-relaxed text-muted">
                <p class="m-0">{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>

      <p class="mt-8 text-[0.9375rem] text-muted">
        Looking for something specific?{" "}
        <a
          class="font-medium text-ink underline decoration-line underline-offset-[0.2em] transition-colors hover:decoration-ink"
          href={`${base}help/`}
        >
          Browse the Getting Started guide
        </a>
        . Or read the{" "}
        <a
          class="font-medium text-ink underline decoration-line underline-offset-[0.2em] transition-colors hover:decoration-ink"
          href={`${base}docs/`}
        >
          full documentation
        </a>
        .
      </p>
    </section>

    <!-- Final CTA / privacy band -->
    <section class="site-shell pb-24 md:pb-32" aria-labelledby="final-title">
      <div
        class="grid items-center gap-10 rounded-[1.5rem] bg-night px-8 py-12 text-on-night sm:px-10 md:grid-cols-[1fr_auto] md:gap-14 md:px-16 md:py-16"
      >
        <div>
          <p class="eyebrow !text-[#a1a1a6]">Local by default</p>
          <h2
            id="final-title"
            class="section-title mb-4 max-w-xl text-on-night"
          >
            Your code never leaves your machine.
          </h2>
          <p class="m-0 max-w-xl text-[1.0625rem] leading-relaxed text-[#a1a1a6]">
            secure-mcp runs entirely on your machine: read-only tools, stdio
            transport, no network, no telemetry — and findings that tell you
            what to fix and how to verify it.
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 md:items-end">
          <a class="btn btn-on-dark" href="#screens">
            See it in action
          </a>
          <a
            class="inline-flex min-h-11 items-center justify-center px-1 text-[0.9375rem] font-medium text-[#d2d2d7] underline decoration-[#6e6e73] underline-offset-[0.35rem] transition-colors hover:decoration-white hover:text-white"
            href={`${base}privacy/`}
          >
            Read privacy details
          </a>
        </div>
      </div>
    </section>
</LandingLayout>
